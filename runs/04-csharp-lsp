#!/usr/bin/env bash

set -euo pipefail

# Ensure dotnet is in PATH for this session
export DOTNET_ROOT="$HOME/.dotnet"
export PATH="$PATH:$DOTNET_ROOT:$DOTNET_ROOT/tools"

if command -v csharp-ls &>/dev/null; then
    echo "csharp-ls already installed, skipping"
    exit 0
fi

if ! command -v dotnet &>/dev/null; then
    echo "Error: dotnet not found. Please install .NET SDK first."
    exit 1
fi

echo "Installing csharp-ls (C# language server)..."

# Install csharp-ls as a .NET global tool
dotnet tool install --global csharp-ls

echo "csharp-ls installed successfully"
csharp-ls --version
